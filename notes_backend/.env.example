# Example environment configuration for Notes Backend
# Copy this file to ".env" and adjust values as needed.
# Note: You do NOT need a .env file for local preview; sensible defaults are used.

# Server settings
# PORT: Optional. If not set, the app defaults to 3000 (see src/server.js).
# HOST: Optional. If not set, the app defaults to 0.0.0.0 (see src/server.js).
#PORT=3000
#HOST=0.0.0.0

# Application environment
# NODE_ENV: Optional. Common values: development, production, test
#NODE_ENV=development

# Database configuration (optional)
# If DB_URL is provided, the app will select "db" mode; otherwise it uses in-memory storage.
# DB_URL: e.g., MongoDB URL like mongodb+srv://user:pass@cluster.example/app
# DB_NAME: database name (defaults to "notes_app" if omitted)
# DB_COLLECTION: notes collection/table name (defaults to "notes" if omitted)
#DB_URL=
#DB_NAME=notes_app
#DB_COLLECTION=notes
